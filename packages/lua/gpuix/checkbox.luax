local util = require("gpuix._util")

return function(props)
    local palette = props.theme or util.palette
    local internal_checked, set_internal_checked = gpuix.use_state(props.defaultChecked == true)
    local controlled = props.checked ~= nil
    local checked = internal_checked
    if controlled then checked = props.checked end
    local state = { checked = checked, disabled = props.disabled == true }

    local function set_checked(next_checked)
        if state.disabled or next_checked == checked then return end
        if not controlled then set_internal_checked(next_checked) end
        util.call(props.onCheckedChange, next_checked)
    end

    local function toggle()
        set_checked(not checked)
    end

    return <div
        testId={props.testId}
        tabIndex={state.disabled and -1 or (props.tabIndex or 0)}
        onClick={toggle}
        style={util.resolve_style(props.style, state, util.row_style(palette, state))}
    >
        <div
            testId={util.test_id(props.testId, "-indicator")}
            onClick={toggle}
            style={util.resolve_style(props.indicatorStyle, state, util.indicator_style(palette, state, false))}
        >
            {checked and <text style={{ pointerEvents = "none" }}>✓</text> or nil}
        </div>
        {props.label and <text>{props.label}</text> or nil}
    </div>
end
