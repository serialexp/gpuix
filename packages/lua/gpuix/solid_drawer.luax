--!gpuix solid
local solid = require("gpuix.solid")
local shared = require("gpuix.solid._util")
local util = require("gpuix._util")
local Show = solid.Show
local read = shared.read

return function(props)
    local function side()
        local current = read(props, "side", "right")
        assert(current == "left" or current == "right" or current == "bottom",
            "gpuix.solid.drawer side must be left, right, or bottom")
        return current
    end
    local initial = props.defaultSize or (side() == "bottom" and 240 or 320)
    local open, set_open = shared.controlled(props, "open", props.defaultOpen ~= false, "onOpenChange")
    local raw_size, set_raw_size = shared.controlled(props, "size", initial, "onSizeChange")
    local function clamp(next_size)
        local minimum, maximum = read(props, "minSize", 160), read(props, "maxSize", 720)
        assert(minimum >= 0 and maximum >= minimum, "Drawer requires 0 <= minSize <= maxSize")
        return math.max(minimum, math.min(maximum, tonumber(next_size) or initial))
    end
    local function size() return clamp(raw_size()) end
    local function set_size(next_size)
        next_size = clamp(next_size)
        if size() ~= next_size then set_raw_size(next_size) end
    end
    local function state()
        return { open = open(), side = side(), size = size(), setOpen = set_open,
            setSize = set_size, close = function() set_open(false) end }
    end
    local drag_position, drag_side
    solid.on_cleanup(function() drag_position = nil end)
    solid.create_effect(function()
        local current_side = side()
        if not open() or not read(props, "resizable", true) or drag_side ~= current_side then
            drag_position = nil
        end
        drag_side = current_side
    end)
    local function coordinate(event)
        if side() == "bottom" then return event.y end
        return event.x
    end
    local function down(event)
        if event.button ~= 0 or not open() or not read(props, "resizable", true) then return end
        drag_position = coordinate(event)
        if drag_position ~= nil then util.call(props.onResizeStart, size()) end
    end
    local function move(event)
        if event.pressedButton ~= 0 or drag_position == nil then return end
        local next_position = coordinate(event)
        if next_position == nil then return end
        local delta = next_position - drag_position
        drag_position = next_position
        if side() ~= "left" then delta = -delta end
        set_size(size() + delta)
    end
    local function up(event)
        if drag_position == nil then return end
        drag_position = nil
        if event.clickCount == 2 then set_size(initial) end
        util.call(props.onResizeEnd, size())
    end
    local function key(event)
        local step = event.modifiers and event.modifiers.shift and 32 or 8
        if event.key == "home" then set_size(initial)
        elseif side() == "left" and event.key == "right"
            or side() == "right" and event.key == "left"
            or side() == "bottom" and event.key == "up" then set_size(size() + step)
        elseif side() == "left" and event.key == "left"
            or side() == "right" and event.key == "right"
            or side() == "bottom" and event.key == "down" then set_size(size() - step) end
    end
    local function keep_mounted()
        if props.renderContent == nil then
            assert(read(props, "keepMounted", true), "Use renderContent for disposable Drawer children")
            return true
        end
        return read(props, "keepMounted", false)
    end
    local function panel_style()
        local result = shared.style({ display = "flex", position = "relative", flexShrink = 0,
            minWidth = 0, minHeight = 0, overflow = "hidden",
            background = "#18181b", borderColor = "#3f3f46" }, props.style, state())
        if side() == "bottom" then
            if result.left == nil and result.right == nil then result.width = "100%" else result.width = nil end
            result.height = open() and size() or 0
            result.borderTopWidth = open() and (result.borderTopWidth or 1) or 0
        else
            result.width, result.height = open() and size() or 0, "100%"
            if side() == "left" then result.borderRightWidth = open() and (result.borderRightWidth or 1) or 0
            else result.borderLeftWidth = open() and (result.borderLeftWidth or 1) or 0 end
        end
        if not open() then
            result.width, result.height = 0, 0
            result.minWidth, result.minHeight = 0, 0
            result.visibility = "hidden"
        end
        return result
    end
    local function handle_style()
        local result = shared.style({ position = "absolute", background = "transparent",
            hover = { background = "#60a5fa66" }, active = { background = "#60a5fa" }, focus = util.focus_ring },
            props.resizeHandleStyle, state())
        local thickness = read(props, "resizeHandleSize", 6)
        result.top = 0
        if side() == "bottom" then
            result.left, result.right = 0, nil
            result.width, result.height, result.cursor = "100%", thickness, "row-resize"
        else
            result.left = side() == "right" and 0 or nil
            result.right = side() == "left" and 0 or nil
            result.width, result.height, result.cursor = thickness, "100%", "col-resize"
        end
        return result
    end
    local panel = <Show testId={props.testId} when={function() return open() or keep_mounted() end}
        render={function()
            local body = props.renderContent and props.renderContent(state) or props
            return <div style={{ position = "relative", width = "100%", height = "100%", minWidth = 0, minHeight = 0 }}>
                <div style={shared.style({ width = "100%", height = "100%", minWidth = 0, minHeight = 0,
                    display = "flex", flexDirection = "column", overflow = "hidden" }, props.contentStyle, state())}
                    children={body} />
                <Show when={function() return open() and read(props, "resizable", true) end}
                    style={{ position = "absolute", width = "100%", height = "100%", pointerEvents = "none" }}
                    render={function()
                        return <div testId={util.test_id(props.testId, "-resize-handle")}
                            tabIndex={read(props, "resizeTabIndex", 0)}
                            onMouseDown={down} onMouseMove={move} onMouseUp={up} onKeyDown={key}
                            style={handle_style()} />
                    end} />
            </div>
        end} />
    solid.bind_style(panel, panel_style)
    if props.renderTrigger == nil then return panel end
    return <div style={{ display = "flex", position = "relative", flexShrink = 0,
        width = open() and (side() == "bottom" and "100%" or size()) or nil,
        height = open() and (side() == "bottom" and size() or "100%") or nil }}>
        {panel}
        <Show when={function() return not open() end}
            render={function() return props.renderTrigger(state) end} />
    </div>
end
