 [features]
 bindgen = ["bindgen-rs"]
 disable-assertions = []
+# Local patch: mix Map/Set key hashes before taking the bucket.
+map-hash-mix = []
 dump-atoms = []
 dump-bytecode = []
 dump-free = []
--- a/build.rs
+++ b/build.rs
@@ -111,6 +111,7 @@
         "dump-promise",
         "dump-read-object",
         "disable-assertions",
+        "map-hash-mix",
     ];
 
     for feature in &features {
@@ -146,6 +147,8 @@
 
     #[cfg(feature = "disable-assertions")]
     defines.push(("NDEBUG".into(), None));
+    #[cfg(feature = "map-hash-mix")]
+    defines.push(("RQUICKJS_MAP_HASH_MIX".into(), None));
 
     let target_os = env::var("CARGO_CFG_TARGET_OS").unwrap();
     let target_env = env::var("CARGO_CFG_TARGET_ENV").unwrap();
@@ -154,6 +157,9 @@
     builder
         .extra_warnings(false)
         .flag_if_supported("-Wno-implicit-const-int-float-conversion")
+        // Local patch: with NDEBUG some variables only feed asserts. Cargo
+        // shows C warnings for path dependencies, so keep the build quiet.
+        .flag_if_supported("-Wno-unused-but-set-variable")
         //.flag("-Wno-array-bounds")
