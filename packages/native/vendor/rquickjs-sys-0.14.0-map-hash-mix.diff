         ;
--- a/quickjs/quickjs.c
+++ b/quickjs/quickjs.c
@@ -53380,7 +53380,20 @@
         h = 0;
         break;
     }
-    return h ^ ctx->hash_seed ^ hash32(tag);
+    h ^= ctx->hash_seed ^ hash32(tag);
+#ifdef RQUICKJS_MAP_HASH_MIX
+    /* The multiplications above move entropy into the high bits, but the
+       bucket is taken from the low bits. Small integers and aligned object
+       pointers have constant low bits, so without this final mix (the
+       MurmurHash3 finalizer) most keys share a few buckets and Map/Set
+       lookups degrade towards a linear scan. */
+    h ^= h >> 16;
+    h *= 0x85ebca6b;
+    h ^= h >> 13;
+    h *= 0xc2b2ae35;
+    h ^= h >> 16;
+#endif
+    return h;
 }
 
