local theme = require("theme")
local DiffPanel = require("components.diff_panel")
local WidgetGallery = require("components.widget_gallery")

return function(props)
    local body
    if props.mode == "code" then
        body = <div style={theme.styles.card}>
            <text style={{ color = theme.colors.muted, fontSize = 12 }}>RUST EVENT PATH</text>
            <code
                code={props.code}
                language="rust"
                showLineNumbers
                theme={theme.native}
                style={{ background = theme.colors.canvas, borderRadius = 8 }}
            />
        </div>
    elseif props.mode == "diff" then
        body = <DiffPanel key="diff" patch={props.patch} />
    elseif props.mode == "widgets" then
        body = <WidgetGallery key="widgets" />
    else
        body = <div style={theme.styles.card}>
            <markdown source={props.markdown} theme={theme.native} />
        </div>
    end

    return <div style={theme.styles.detail}>
        <div style={{ display = "flex", flexDirection = "row", alignItems = "center", gap = 8, width = "100%", minWidth = 0 }}>
            <text style={{
                fontSize = 22,
                minWidth = 0,
                flexShrink = 1,
                whiteSpace = "nowrap",
                overflow = "hidden",
                textOverflow = "ellipsis",
            }}>{props.title}</text>
            <div style={{ flexGrow = 1 }} />
            <text style={{ color = theme.colors.faint, fontSize = 12, flexShrink = 0 }}>retained native tree</text>
        </div>
        {body}
    </div>
end
