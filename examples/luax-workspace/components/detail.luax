local theme = require("theme")

return function(props)
    local body = props.mode == "code"
        and <div style={theme.styles.card}>
            <text style={{ color = theme.colors.muted, fontSize = 12 }}>RUST EVENT PATH</text>
            <code
                code={props.code}
                language="rust"
                showLineNumbers
                theme={theme.native}
                style={{ background = theme.colors.canvas, borderRadius = 8 }}
            />
        </div>
        or <div style={theme.styles.card}>
            <markdown source={props.markdown} theme={theme.native} />
        </div>

    return <div style={theme.styles.detail}>
        <div style={{ display = "flex", flexDirection = "row", alignItems = "center", gap = 8, width = "100%", minWidth = 0 }}>
            <text style={{
                fontSize = 22,
                minWidth = 0,
                flexShrink = 1,
                whiteSpace = "nowrap",
                overflow = "hidden",
                textOverflow = "ellipsis",
            }}>{props.title}</text>
            <div style={{ flexGrow = 1 }} />
            <text style={{ color = theme.colors.faint, fontSize = 12, flexShrink = 0 }}>retained native tree</text>
        </div>
        {body}
    </div>
end
