local theme = require("theme")

return function(props)
    local sent, set_sent = gpuix.use_state(0)

    return <div style={theme.styles.composer}>
        <input
            testId="workspace-composer"
            value={props.value}
            placeholder="Type into the native input…"
            onChange={props.onChange}
            onSubmit={function()
                set_sent(function(value) return value + 1 end)
                props.onClear()
            end}
            style={theme.styles.input}
        />
        <div
            testId="send-message"
            style={theme.styles.button_active}
            onClick={function()
                set_sent(function(value) return value + 1 end)
                props.onClear()
            end}
        >
            <text>Send ({sent})</text>
        </div>
    </div>
end
