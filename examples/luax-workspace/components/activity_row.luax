local theme = require("theme")
local colors = theme.colors

local base = gpuix.style {
    display = "flex",
    flexDirection = "column",
    flexShrink = 0,
    padding = 10,
    gap = 4,
    borderRadius = 8,
    background = "#1d2027",
    borderWidth = 1,
    borderColor = "#2d323d",
}
local active_style = gpuix.style {
    display = "flex",
    flexDirection = "column",
    flexShrink = 0,
    padding = 10,
    gap = 4,
    borderRadius = 8,
    background = "#252933",
    borderWidth = 1,
    borderColor = "#e2795b",
}

return function(props)
    return <div
        key={props.item.id}
        testId={props.item.id}
        style={props.active and active_style or base}
        onClick={function() props.onSelect(props.item.id) end}
    >
        <div style={{ display = "flex", flexDirection = "row", gap = 8, width = "100%", minWidth = 0 }}>
            <text style={{
                color = props.active and colors.accent or colors.text,
                minWidth = 0,
                flexShrink = 1,
                whiteSpace = "nowrap",
                overflow = "hidden",
                textOverflow = "ellipsis",
            }}>
                {props.item.title}
            </text>
            <div style={{ flexGrow = 1 }} />
            <text style={{ color = colors.green, fontSize = 11, flexShrink = 0 }}>{props.item.status}</text>
        </div>
        <text style={{
            color = colors.faint,
            fontSize = 11,
            whiteSpace = "nowrap",
            overflow = "hidden",
            textOverflow = "ellipsis",
        }}>{props.item.detail}</text>
    </div>
end
