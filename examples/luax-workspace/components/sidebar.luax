local theme = require("theme")
local icons = require("icons")
local styles = theme.styles
local colors = theme.colors

return function(props)
    local list_focused, set_list_focused = gpuix.use_state(false)
    local focused_id, set_focused_id = gpuix.use_state(props.activeId)

    local function item_index(item_id)
        for index, conversation in ipairs(props.items) do
            if conversation.id == item_id then return index end
        end
        return 1
    end

    local function move(direction)
        if #props.items == 0 then return end
        local index = math.max(1, math.min(#props.items, item_index(focused_id) + direction))
        set_focused_id(props.items[index].id)
    end

    local function focus_index(index)
        local conversation = props.items[index]
        if conversation ~= nil then set_focused_id(conversation.id) end
    end

    local function activate_focused()
        local conversation = props.items[item_index(focused_id)]
        if conversation ~= nil and conversation.id ~= props.activeId then
            props.onSelect(conversation.id)
        end
    end

    local function handle_key(event)
        if event.key == "down" then
            move(1)
        elseif event.key == "up" then
            move(-1)
        elseif event.key == "home" then
            focus_index(1)
        elseif event.key == "end" then
            focus_index(#props.items)
        elseif event.key == "enter" or event.key == "space" then
            activate_focused()
        end
    end

    local rows = {}
    for index, conversation in ipairs(props.items) do
        local active = conversation.id == props.activeId
        local focused = list_focused and conversation.id == focused_id
        local style = focused and styles.button_focused or styles.button
        if active then
            style = focused and styles.button_active_focused or styles.button_active
        end
        rows[index] = <div
            key={conversation.id}
            testId={"conversation-" .. conversation.id}
            style={style}
            onClick={function()
                set_focused_id(conversation.id)
                props.onSelect(conversation.id)
            end}
        >
            <text style={{
                minWidth = 0,
                flexShrink = 1,
                whiteSpace = "nowrap",
                overflow = "hidden",
                textOverflow = "ellipsis",
            }}>{props.compact and string.sub(conversation.title, 1, 2) or conversation.title}</text>
        </div>
    end

    return <div testId="workspace-sidebar" style={props.compact and styles.sidebar_compact or styles.sidebar}>
        <div style={{ display = "flex", flexDirection = "row", alignItems = "center", gap = 10 }}>
            <svg source={icons.logo} style={{ width = 28, height = 28 }} />
            {not props.compact and <text style={{ fontSize = 17, color = colors.text }}>GPUIX Lua</text> or nil}
        </div>
        <div style={{ height = 1, background = colors.border }} />
        <div
            testId="conversation-list"
            tabIndex={0}
            onFocus={function()
                set_focused_id(props.activeId)
                set_list_focused(true)
            end}
            onBlur={function() set_list_focused(false) end}
            onKeyDown={handle_key}
            style={{
                display = "flex",
                flexDirection = "column",
                gap = 7,
                borderRadius = 8,
            }}
            children={rows}
        />
        <div style={{ flexGrow = 1 }} />
        <text style={{ color = colors.faint, fontSize = 11 }}>
            {props.compact and "LuaX" or "No JavaScript runtime"}
        </text>
    </div>
end
