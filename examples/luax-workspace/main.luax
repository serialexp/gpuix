local ui = gpuix
local theme = require("theme")
local data = require("data")
local icons = require("icons")
local store = require("store")
local Sidebar = require("components.sidebar")
local Detail = require("components.detail")
local ActivityList = require("components.activity_list")
local Composer = require("components.composer")
local Button = require("gpuix.button")
local DockLayout = require("gpuix.dock_layout")
local app = ui.create_app()

local function title_for(id)
    for _, conversation in ipairs(data.conversations) do
        if conversation.id == id then return conversation.title end
    end
    return "Workspace"
end

local function select_active_id(state) return state.active_id end
local function select_compact(state) return state.compact end
local function select_mode(state) return state.mode end
local function select_activity(state) return state.selected_activity end
local function select_draft(state) return state.draft end

local function set_active_id(id)
    store.dispatch({ type = "select_conversation", id = id })
end

local function set_selected_activity(id)
    store.dispatch({ type = "select_activity", id = id })
end

local function MainWindow()
    local active_id = store.use_state(select_active_id)
    local compact = store.use_state(select_compact)
    local mode = store.use_state(select_mode)
    local selected_activity = store.use_state(select_activity)
    local draft = store.use_state(select_draft)
    local inspector_open = ui.use_window_open(app, "inspector")
    local panels = {{
        id = "activity",
        label = "Activity",
        buttonLabel = "ACT",
        position = "right",
        defaultOpen = true,
        defaultSize = 340,
        minSize = 260,
        maxSize = 560,
        style = {
            background = theme.colors.sidebar,
            borderColor = theme.colors.border,
        },
        renderButton = function(state)
            return <svg
                testId="activity-dock-icon"
                source={icons.activity}
                style={{
                    width = 16,
                    height = 16,
                    color = state.active and theme.colors.text or theme.colors.muted,
                }}
            />
        end,
        render = function()
            return <ActivityList
                items={data.activities}
                selectedId={selected_activity}
                onSelect={set_selected_activity}
            />
        end,
    }}

    return <DockLayout
        testId="luax-workspace"
        panels={panels}
        style={theme.styles.dock_root}
        statusBarStyle={theme.styles.status_bar}
    >
        <Sidebar
            items={data.conversations}
            activeId={active_id}
            compact={compact}
            onSelect={set_active_id}
        />
        <div testId="workspace-content" style={theme.styles.content}>
            <div testId="workspace-navbar" style={theme.styles.header}>
                <Button
                    testId="toggle-sidebar"
                    style={theme.styles.button}
                    onClick={function() store.dispatch({ type = "toggle_sidebar" }) end}
                >
                    <text>{compact and "Expand" or "Compact"}</text>
                </Button>
                <text style={{ color = theme.colors.muted }}>LuaX</text>
                <div style={{ flexGrow = 1 }} />
                <Button
                    testId="open-inspector"
                    style={inspector_open and theme.styles.button_active or theme.styles.button}
                    onClick={function()
                        if inspector_open then
                            ui.close_window(app, "inspector")
                        else
                            ui.open_window(app, "inspector")
                        end
                    end}
                ><text>Inspector</text></Button>
                <Button
                    testId="show-markdown"
                    style={mode == "markdown" and theme.styles.button_active or theme.styles.button}
                    onClick={function() store.dispatch({ type = "set_mode", mode = "markdown" }) end}
                ><text>Markdown</text></Button>
                <Button
                    testId="show-code"
                    style={mode == "code" and theme.styles.button_active or theme.styles.button}
                    onClick={function() store.dispatch({ type = "set_mode", mode = "code" }) end}
                ><text>Code</text></Button>
                <Button
                    testId="show-diff"
                    style={mode == "diff" and theme.styles.button_active or theme.styles.button}
                    onClick={function() store.dispatch({ type = "set_mode", mode = "diff" }) end}
                ><text>Diff</text></Button>
                <Button
                    testId="show-widgets"
                    style={mode == "widgets" and theme.styles.button_active or theme.styles.button}
                    onClick={function() store.dispatch({ type = "set_mode", mode = "widgets" }) end}
                ><text>Widgets</text></Button>
            </div>
            <div testId="workspace-body" style={theme.styles.body}>
                <Detail
                    title={title_for(active_id)}
                    mode={mode}
                    markdown={data.overview}
                    code={data.code}
                    patch={data.patch}
                />
            </div>
            <Composer
                value={draft}
                onChange={function(event)
                    store.dispatch({ type = "set_draft", value = event.value or "" })
                end}
                onClear={function() store.dispatch({ type = "set_draft", value = "" }) end}
            />
        </div>
    </DockLayout>
end

local function InspectorWindow()
    local active_id = store.use_state(select_active_id)
    local mode = store.use_state(select_mode)
    local selected_activity = store.use_state(select_activity)
    local draft = store.use_state(select_draft)

    return <div style={{
        display = "flex",
        flexDirection = "column",
        width = "100%",
        height = "100%",
        padding = 20,
        gap = 14,
        background = theme.colors.background,
        color = theme.colors.text,
    }}>
        <div style={{ display = "flex", alignItems = "center", gap = 8 }}>
            <text style={{ fontSize = 18, fontWeight = 700 }}>Shared inspector</text>
            <div style={{ flexGrow = 1 }} />
            <Button
                testId="close-inspector"
                style={theme.styles.button}
                onClick={function() ui.close_window(app, "inspector") end}
            ><text>Close</text></Button>
        </div>
        <text style={{ color = theme.colors.muted }}>
            This is a separate GPUI window backed by the same Lua store.
        </text>
        <div style={{ height = 1, background = theme.colors.border }} />
        <text>Conversation: {title_for(active_id)}</text>
        <text>Mode: {mode}</text>
        <text>Activity: {selected_activity}</text>
        <text>Draft: {draft == "" and "(empty)" or draft}</text>
    </div>
end

ui.define_window(app, {
    id = "main",
    title = "GPUIX Lua Workspace",
    width = 1280,
    height = 800,
    render = MainWindow,
})

ui.define_window(app, {
    id = "inspector",
    title = "Workspace Inspector",
    width = 420,
    height = 360,
    open = false,
    render = InspectorWindow,
})

return app
