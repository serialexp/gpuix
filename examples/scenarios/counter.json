{
  "schemaVersion": 1,
  "name": "Solid Lua counter",
  "app": "../solid-counter.luax",
  "timeoutMs": 5000,
  "steps": [
    { "action": "expectVisible", "testId": "solid-counter" },
    { "action": "expectText", "testId": "solid-counter", "text": "Count: 0", "exact": true },
    { "action": "click", "testId": "solid-counter", "name": "Increment by clicking" },
    { "action": "expectText", "testId": "solid-counter", "text": "Count: 1", "exact": true },
    { "action": "press", "keys": "enter" },
    { "action": "expectText", "testId": "solid-counter", "text": "Count: 2", "exact": true },
    { "action": "screenshot", "name": "Counter after mouse and keyboard activation" }
  ]
}
